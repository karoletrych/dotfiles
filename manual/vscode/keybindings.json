// Place your key bindings in this file to override the defaults
[
    {
        "key": "shift+alt+l",
        "command": "workbench.files.action.showActiveFileInExplorer"
    },
    {
        "key": "shift+alt+b",
        "command": "git.blame.toggleEditorDecoration"
    },
    {
        "key": "shift+alt+d",
        "command": "git.viewChanges"
    },
    {
        "key": "shift+alt+n",
        "command": "multiDiffEditor.goToNextChange"
    },
    {
        "key": "shift+alt+p",
        "command": "multiDiffEditor.goToPreviousChange"
    },
    {
        "key": "shift+alt+u",
        "command": "diffEditor.showAllUnchangedRegions",
        "when": "isInDiffEditor"
    },
    {
        "key": "shift+alt+c",
        "command": "diffEditor.collapseAllUnchangedRegions",
        "when": "isInDiffEditor"
    },
    {
        "key": "ctrl+shift+f11",
        "command": "editor.action.goToTypeDefinition",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+f12",
        "command": "editor.showCallHierarchy",
        "when": "editorHasCallHierarchyProvider && editorTextFocus"
    },
    {
        "key": "shift+f12",
        "command": "references-view.findReferences",
        "when": "editorHasReferenceProvider"
    },
    {
        "key": "shift+f12",
        "command": "-editor.action.goToReferences"
    }
]
