// Place your key bindings in this file to override the defaults
[
    {
        "key": "shift+alt+l",
        "command": "workbench.files.action.showActiveFileInExplorer"
    },
    {
        "key": "ctrl+q ctrl+b",
        "command": "runCommands",
        "args": {
            "commands": [
                "git.blame.toggleEditorDecoration",
                "editor.action.selectAll",
                "editor.action.insertCursorAtEndOfEachLineSelected"
            ]
        },
        "when": "editorTextFocus && !config.git.blame.editorDecoration.enabled"
    },
    {
        "key": "ctrl+q ctrl+b",
        "command": "runCommands",
        "args": {
            "commands": [
                "editor.action.selectAll",
                "editor.action.insertCursorAtEndOfEachLineSelected"
            ]
        },
        "when": "editorTextFocus && config.git.blame.editorDecoration.enabled"
    },
    {
        "key": "shift+alt+b",
        "command": "git.blame.toggleEditorDecoration"
    },
    {
        "key": "shift+alt+d",
        "command": "git.viewChanges"
    },
    {
        "key": "shift+alt+n",
        "command": "multiDiffEditor.goToNextChange"
    },
    {
        "key": "shift+alt+p",
        "command": "multiDiffEditor.goToPreviousChange"
    },
    {
        "key": "shift+alt+u",
        "command": "diffEditor.showAllUnchangedRegions",
        "when": "isInDiffEditor"
    },
    {
        "key": "shift+alt+c",
        "command": "diffEditor.collapseAllUnchangedRegions",
        "when": "isInDiffEditor"
    },
    {
        "key": "ctrl+shift+f11",
        "command": "editor.action.goToTypeDefinition",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+f12",
        "command": "editor.showCallHierarchy",
        "when": "editorHasCallHierarchyProvider && editorTextFocus"
    },
    {
        "key": "shift+f12",
        "command": "references-view.findReferences",
        "when": "editorHasReferenceProvider"
    },
    {
        "key": "shift+f12",
        "command": "-editor.action.goToReferences"
    },
    {
        "key": "ctrl+alt+s",
        "command": "workbench.action.openSettings"
    },
    {
        "key": "ctrl+1",
        "command": "numberedBookmarks.jumpToBookmark1",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+2",
        "command": "numberedBookmarks.jumpToBookmark2",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+3",
        "command": "numberedBookmarks.jumpToBookmark3",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+4",
        "command": "numberedBookmarks.jumpToBookmark4",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+5",
        "command": "numberedBookmarks.jumpToBookmark5",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+6",
        "command": "numberedBookmarks.jumpToBookmark6",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+7",
        "command": "numberedBookmarks.jumpToBookmark7",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+8",
        "command": "numberedBookmarks.jumpToBookmark8",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+9",
        "command": "numberedBookmarks.jumpToBookmark9",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+1",
        "command": "numberedBookmarks.toggleBookmark1",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+2",
        "command": "numberedBookmarks.toggleBookmark2",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+3",
        "command": "numberedBookmarks.toggleBookmark3",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+4",
        "command": "numberedBookmarks.toggleBookmark4",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+5",
        "command": "numberedBookmarks.toggleBookmark5",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+6",
        "command": "numberedBookmarks.toggleBookmark6",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+7",
        "command": "numberedBookmarks.toggleBookmark7",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+8",
        "command": "numberedBookmarks.toggleBookmark8",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+shift+9",
        "command": "numberedBookmarks.toggleBookmark9",
        "when": "editorTextFocus"
    }
]
