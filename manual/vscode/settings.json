{
    "workbench.colorTheme": "Catppuccin Macchiato",
    "workbench.iconTheme": "catppuccin-macchiato",
    "workbench.tree.indent": 12,
    "catppuccin-icons.associations.folders": {
        "Domain": "folder_core",
        "Dictionaries": "folder_database",
        "WebApi": "folder_api",
        "Entities": "folder_types",
        "UnitTests": "folder_tests"
    },
    "workbench.colorCustomizations": {
        "[Quiet Light]": {
            "gitDecoration.ignoredResourceForeground": "#b3b3b3"
        },
        "[Catppuccin Macchiato]": {
            "gitDecoration.ignoredResourceForeground": "#6e738d"
        }
    },

    "workbench.editor.enablePreview": false,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 10,
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.limit.excludeDirty": true,
    "workbench.editor.tabSizing": "shrink",

    "editor.semanticTokenColorCustomizations": {
        "[Catppuccin Macchiato]": {
            "rules": {
                "parameter:csharp": "#cad3f5",
                "selfKeyword:csharp": "#c6a0f6",
                "variable.defaultLibrary:csharp": "#cad3f5"
            }
        }
    },
    "editor.fontFamily": "'JetBrains Mono', 'JetBrainsMono Nerd Font', Consolas, 'Courier New', monospace",
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.renderWhitespace": "all",
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports.biome": "always",
        "source.fixAll.biome": "always"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    "vim.handleKeys": {
        "<C-p>": false,
        "<C-t>": false,
        "<C-k>": false
    },

    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnPaste.enabled": false,
    "files.watcherExclude": {
        "**/dist/**": true,
        "**/node_modules/**": true
    },

    "git.openRepositoryInParentFolders": "always",
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.blame.editorDecoration.enabled": true,
    "git.blame.statusBarItem.enabled": true,

    "dotnet.codeLens.enableReferencesCodeLens": false,
    "csharp.suppressBuildAssetsNotification": true,

    "chat.disableAIFeatures": true,
    "claudeCode.preferredLocation": "panel",

    "rest-client.previewOption": "exchange",
    "redhat.telemetry.enabled": false,
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://biomejs.dev": true
    },

    "workbench.remoteIndicator.showExtensionRecommendations": false,

    "security.workspace.trust.banner": "never",
    "security.workspace.trust.enabled": false,
    "extensions.ignoreRecommendations": true,
    "diffEditor.renderSideBySide": false
}
